# Copy this file to .env for local development, or add each value in
# Vercel Project Settings -> Environment Variables for production.
# Never commit the filled-in .env file.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-long-random-secret

# Encrypts the Google credential cookie. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Google Cloud OAuth client of type "Web application" (not Desktop).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret

# Must exactly match an authorized redirect URI on the OAuth client.
# Local:      http://localhost:5000/auth/callback
# Production: https://odyssey-ai-livid.vercel.app/auth/callback
OAUTH_REDIRECT_URI=http://localhost:5000/auth/callback

# Gemini API key from Google AI Studio. Optional: without it Odyssey still
# searches Gmail, shows storage, and composes, using simple keyword routing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional, comma-separated. Tried in order when GEMINI_MODEL is overloaded (503),
# rate-limited (429), or unavailable. Leave empty to let Odyssey pick suitable
# Flash models automatically from the models your key can use.
GEMINI_FALLBACK_MODELS=

# Optional. Vercel sets VERCEL_ENV automatically; set this to 1 to force
# production behavior (secure cookies) on another host.
# ODYSSEY_PRODUCTION=1
LOG_LEVEL=INFO
